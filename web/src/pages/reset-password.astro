---
import Auth from "../layouts/Auth.astro";
---
<Auth title="Reset password · Xebeka" description="Get a link to set a new password for your Xebeka account.">
  <div data-view="form">
    <h1 class="auth__title" tabindex="-1">Reset password</h1>
    <p class="auth__lead">Enter the email address of your account. We will send you a link to set a new password.</p>
    <form class="form" data-form novalidate>
      <div class="field">
        <label for="email">Email</label>
        <input class="input" id="email" name="email" type="email" autocomplete="email" required maxlength="254" />
      </div>
      <p class="form__error" role="alert" data-error hidden></p>
      <button class="btn btn--lg notch form__submit" type="submit" data-submit>Send link</button>
    </form>
    <p class="auth__alt">Remembered it? <a href="/login/">Log in</a></p>
  </div>

  <div data-view="sent" hidden>
    <h1 class="auth__title" tabindex="-1">Check your inbox</h1>
    <p class="auth__lead">If an account uses <strong data-sent-to></strong>, a link to set a new password is on its way. It works for one hour.</p>
    <p class="auth__text">Nothing there after a few minutes? Look in your spam folder, or <a href="/reset-password/">ask again</a>.</p>
  </div>

  <script>
    import "../scripts/reset.ts";
  </script>
</Auth>
