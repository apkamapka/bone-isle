---
import Auth from "../../layouts/Auth.astro";
---
<Auth title="Logging in · Xebeka" description="Finishing a Google sign-in.">
  <div data-view="working">
    <h1 class="auth__title" tabindex="-1">Logging in</h1>
    <p class="auth__lead">Finishing your Google sign-in…</p>
  </div>

  <div data-view="cancelled" hidden>
    <h1 class="auth__title" tabindex="-1">Sign-in cancelled</h1>
    <p class="auth__lead">You left Google without choosing an account. Nothing has changed.</p>
    <div class="auth__actions">
      <a class="btn notch" href="/login/">Back to log in</a>
    </div>
  </div>

  <div data-view="failed" hidden>
    <h1 class="auth__title" tabindex="-1">Could not log in with Google</h1>
    <p class="auth__lead" data-error></p>
    <div class="auth__actions">
      <a class="btn notch" href="/login/">Back to log in</a>
    </div>
  </div>

  <script>
    import "../../scripts/google-return.ts";
  </script>
</Auth>
