---
import Doc from "../layouts/Doc.astro";
// The attribution record kept next to the game's art, rendered at build time:
// whatever CREDITS.md says on deploy is what this page says, and the page the
// licences require stays reachable from the game's own origin even when the
// repository is private.
import { Content as Credits, getHeadings } from "../../../CREDITS.md";

const TOC = getHeadings()
  .filter((h) => h.depth === 2)
  // Headings read "Bandit — public/mob-bandit.png, …"; the index shows the name.
  .map((h) => ({ id: h.slug, label: h.text.split(" — ")[0] }));
---
<Doc
  title="Credits · Xebeka"
  description="The artists whose work appears in Xebeka, with the licence and source of every piece."
  heading="Credits"
  toc={TOC}
>
  <p>
    Xebeka is drawn with art shared by many artists under open and free licences. Every piece used
    in the game is credited below with its authors, its licence and where it comes from, together
    with what was changed to fit it into the game.
  </p>
  <div class="credits">
    <Credits />
  </div>
</Doc>
