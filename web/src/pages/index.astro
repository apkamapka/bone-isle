---
import Base from "../layouts/Base.astro";
import Panel from "../components/Panel.astro";
---
<Base
  title="Xebeka, an online RPG you play in the browser"
  description="Xebeka is an online role-playing game played in the browser, with nothing to install. It is not open yet."
>
  <Panel title="Xebeka is not open yet">
    <p>
      Xebeka is an online role-playing game you play in the browser, with nothing to install.
      You begin on an island of your own, and from there you cross to Bonetown, where every
      player shares the streets, the traders and the hunting grounds beyond.
    </p>
    <p>The creatures out there are shared and fought over, and from level 10 so are you.</p>
    <p>
      The first world opens after testing. Accounts, the library of creatures and items,
      and the highscores open with it.
    </p>
  </Panel>
</Base>
