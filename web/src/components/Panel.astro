---
/** A window in the game's chrome: optional title bar, then the body. */
interface Props {
  title?: string;
  as?: "section" | "aside" | "nav" | "div";
  label?: string;
}
const { title, as: Tag = "section", label } = Astro.props;
---
<Tag class="panel" aria-label={label}>
  {title && (
    <div class="panel__bar">
      <h2 class="panel__title">{title}</h2>
    </div>
  )}
  <div class="panel__body">
    <slot />
  </div>
</Tag>
