---
/**
 * Continue with Google, shown above the email form on /login/ and /signup/.
 * The picture is Google's own pre-approved button artwork, unchanged, as its
 * brand guidelines require; the option stays hidden until that file loads.
 * Going through Google can create an account, so the Terms notice sits here
 * on both pages.
 */
---
<div class="google" data-google hidden>
  <button class="google__btn" type="button">
    <img src="/art/google-continue.svg" alt="Continue with Google" height="44" />
  </button>
  <p class="google__terms">
    By continuing with Google, you confirm you are 13 or older and accept the <a href="/terms/" target="_blank" rel="noopener">Terms of Service</a>.
  </p>
  <p class="form__error" role="alert" data-google-error hidden></p>
  <p class="or">or</p>
</div>
