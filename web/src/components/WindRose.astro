---
/*
 * A portolan chart's wind rose: thirty-two rhumb lines out of one centre, the
 * lines a xebec's pilot laid his course along. It is the one ornament on the
 * site, and it is a sea chart because the name is a ship.
 *
 * The eight winds are gold, the half-winds and quarter-winds sea-green and
 * fainter, the way the charts inked them in three colours.
 */
const REACH = 2400;
const lines = Array.from({ length: 32 }, (_, i) => {
  const a = (i * Math.PI) / 16;
  const kind = i % 4 === 0 ? "wind" : i % 2 === 0 ? "half" : "quarter";
  return {
    x: Math.round(Math.cos(a) * REACH),
    y: Math.round(Math.sin(a) * REACH),
    kind,
  };
});
---
<svg class="masthead__rose" viewBox="-500 -500 1000 1000" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
  {lines.map((l) => (
    <line
      x1="0" y1="0" x2={l.x} y2={l.y}
      stroke={l.kind === "wind" ? "var(--gold)" : "var(--sea-line)"}
      stroke-opacity={l.kind === "wind" ? 0.38 : l.kind === "half" ? 0.24 : 0.14}
      stroke-width="1"
      vector-effect="non-scaling-stroke"
    />
  ))}
</svg>
