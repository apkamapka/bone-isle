---
import Base from "./Base.astro";
import { newsDate, newsIso } from "../lib/news.ts";

/**
 * Every long page (terms, privacy, credits, and later the FAQ and the news
 * posts): a strip of the river instead of the home page's big scene, one
 * column of text, and an index of its sections beside it on wide screens.
 */
interface Props {
  title: string;
  description: string;
  heading: string;
  updated?: string;
  /** A news post's day, shown under its headline. */
  posted?: Date;
  toc?: { id: string; label: string }[];
}
const { title, description, heading, updated, posted, toc = [] } = Astro.props;
---
<Base title={title} description={description}>
  <div class="band" aria-hidden="true"></div>
  <div class="doc">
    <article class="doc__body">
      <h1 class="doc__title">{heading}</h1>
      {updated && <p class="doc__date">Last updated {updated}</p>}
      {posted && <p class="doc__date"><time datetime={newsIso(posted)}>{newsDate(posted)}</time></p>}
      <slot />
    </article>
    {toc.length > 0 && (
      <aside class="doc__toc">
        <h2 class="doc__toc-title">On this page</h2>
        <nav aria-label="On this page">
          <ul>
            {toc.map((t) => <li><a href={`#${t.id}`}>{t.label}</a></li>)}
          </ul>
        </nav>
      </aside>
    )}
  </div>
</Base>
